# Copy to .env and fill in. .env is git-ignored; never commit real values.

# 1Click partner API key from https://partners.near-intents.org/
# Without it, quotes still work but 1Click adds 25 bps on top of any app fee.
ONECLICK_API_KEY=

# --- Gate 1 payment spike (scripts/payment-spike.mjs) ---

# NEAR Intents account that receives test payments (tests 1, 2, 4).
SPIKE_MERCHANT_INTENTS_ACCOUNT=
# Tron address you control: refund address for test 1, refund destination for test 4.
SPIKE_TRON_REFUND_ADDRESS=
# Throwaway EVM key for tests 2 and 3. Use a fresh wallet holding only a few dollars.
SPIKE_EVM_PRIVATE_KEY=
# NEAR account standing in for the escrow contract (test 5).
SPIKE_ESCROW_ACCOUNT=
# Optional: NEAR RPC for Verifier balance reads (default https://rpc.mainnet.fastnear.com).
NEAR_RPC_URL=

# --- Web (apps/web) ---

# Public origin of the landing page, e.g. https://your-domain. Used for canonical URLs, the
# sitemap, robots and absolute social-image URLs. While unset, the site asks search engines
# not to index it, so previews and local builds stay out of results.
NEXT_PUBLIC_SITE_URL=

