# Copy to .env and fill in. .env is git-ignored; never commit real values.

# 1Click partner API key from https://partners.near-intents.org/
# Without it, quotes still work but 1Click adds 25 bps on top of any app fee.
ONECLICK_API_KEY=

# --- Gate 1 payment spike (scripts/payment-spike.mjs) ---

# NEAR Intents account that receives test payments (tests 1, 2, 4).
SPIKE_MERCHANT_INTENTS_ACCOUNT=
# Tron address you control: refund address for test 1, refund destination for test 4.
SPIKE_TRON_REFUND_ADDRESS=
# Throwaway EVM key for tests 2 and 3. Use a fresh wallet holding only a few dollars.
SPIKE_EVM_PRIVATE_KEY=
# NEAR account standing in for the escrow contract (test 5).
SPIKE_ESCROW_ACCOUNT=
# Optional: NEAR RPC for Verifier balance reads (default https://rpc.mainnet.fastnear.com).
NEAR_RPC_URL=

# --- Web (apps/web) ---

# Public origin of the landing page, e.g. https://your-domain. Used for canonical URLs, the
# sitemap, robots and absolute social-image URLs. While unset, the site asks search engines
# not to index it, so previews and local builds stay out of results.
NEXT_PUBLIC_SITE_URL=

# --- API (apps/api) ---

# Postgres connection string, e.g. postgres://morva:morva@localhost:5432/morva
DATABASE_URL=
# WebAuthn relying party ID: Morva's own domain, without scheme or port (e.g. morva.xyz, or
# localhost in development). Passkeys are bound to it, so it can't change once merchants exist.
RP_ID=
RP_NAME=Morva
# The exact origin the web app is served from (e.g. https://morva.xyz or http://localhost:3000).
# Only this origin may send state-changing requests.
WEB_ORIGIN=
# At least 32 random characters, e.g. `openssl rand -base64 48`. Used for email-code HMACs only;
# it cannot move funds.
SESSION_SECRET=
# 1 only for plain-http local development; cookies are Secure otherwise.
INSECURE_COOKIES=
# 1 only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=
API_PORT=8787

# --- Live mainnet test runs (there is no NEAR Intents testnet) ---

# Scripts refuse any live run without this, and any quote above it. Keep it small, e.g. 5.
MAX_TEST_SPEND_USD=
# The dedicated test merchant's software passkey (PKCS#8, base64). Generate with
# `node scripts/test-merchant.mjs new`. Lives only in your local .env; fund with at most
# MAX_TEST_SPEND_USD.
TEST_MERCHANT_P256_KEY=

